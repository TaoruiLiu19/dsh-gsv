{
  "name": "dsh-gsv-tts",
  "version": "2.5.0",
  "description": "DSH plugin for GSV-TTS-Lite: voice presets, auto-read, engine setup assistant, read-aloud button, and settings panel",
  "keywords": [
    "dsh-plugin",
    "tts",
    "voice",
    "voice-cloning",
    "text-to-speech",
    "speech-synthesis",
    "deepseek-harness"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaoruiLiu19/dsh-gsv.git"
  },
  "homepage": "https://github.com/TaoruiLiu19/dsh-gsv#readme",
  "bugs": {
    "url": "https://github.com/TaoruiLiu19/dsh-gsv/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "docs/images",
    "docs/PUBLISHING.md",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "CHANGELOG_EN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "node scripts/verify-manifest.mjs",
    "prepublishOnly": "npm run verify",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
